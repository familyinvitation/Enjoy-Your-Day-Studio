name: Enjoy Your Day Studio videos
on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:
    inputs:
      preview:
        description: 'Generate previews only (no uploads or Sheet edits)'
        type: boolean
        default: true
permissions:
  contents: read
concurrency:
  group: birthday-queue
  cancel-in-progress: false
jobs:
  birthdays:
    runs-on: ubuntu-latest
    timeout-minutes: 50
    env:
      GOOGLE_SERVICE_ACCOUNT_JSON: ${{ secrets.GOOGLE_SERVICE_ACCOUNT_JSON }}
      GOOGLE_SHEET_ID: ${{ secrets.GOOGLE_SHEET_ID }}
      YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
      YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
      YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
      YOUTUBE_CHANNEL_ID: ${{ secrets.YOUTUBE_CHANNEL_ID }}
      GOOGLE_SHEET_TAB: Names
      TTS_VOICE: en-US-Neural2-F
      YOUTUBE_PRIVACY: ${{ vars.YOUTUBE_PRIVACY || 'private' }}
      MADE_FOR_KIDS: ${{ vars.MADE_FOR_KIDS }}
      MAX_PER_RUN: '3'
      UPLOADS_ENABLED: ${{ vars.UPLOADS_ENABLED || 'false' }}
      PREVIEW: ${{ inputs.preview }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
      - name: Install FFmpeg and fonts
        run: sudo apt-get update && sudo apt-get install -y ffmpeg fonts-dejavu-core
      - name: Install Python packages
        run: python -m pip install -r requirements.txt
      - name: Process queue
        shell: bash
        run: |
          if [ "$PREVIEW" = "true" ]; then
            python -m src.main --preview
          elif [ "$UPLOADS_ENABLED" = "true" ]; then
            python -m src.main
          else
            echo "Uploads disabled. Use manual preview or set UPLOADS_ENABLED=true after setup."
          fi
      - name: Save preview videos
        if: inputs.preview == true
        uses: actions/upload-artifact@v4
        with:
          name: birthday-previews
          path: |
            output/*.mp4
            output/*.jpg
          retention-days: 3
          if-no-files-found: warn
